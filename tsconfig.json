{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020", "DOM"],
    "allowJs": true,
    "checkJs": false,
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": "./src",
    "outDir": "./dist",
    "types": ["jest", "node"], // 👈 evita tener que importar jest
    "resolveJsonModule": true,
    "noEmit": true // 👈 evita generar archivos al compilar en dev
  },
  "include": ["src", "tests"],
  "exclude": ["node_modules", "dist"]
}
